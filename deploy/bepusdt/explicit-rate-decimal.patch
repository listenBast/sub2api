+var explicitOrderRate = regexp.MustCompile(`^[0-9]{1,18}(?:\.[0-9]{1,18})?$`)
+
 func GetOrderRate(token Crypto, fiat Fiat, syntax string) (decimal.Decimal, error) {
+	// Explicit native API rates are authoritative per-order decimal quotes. They
+	// must not round-trip through float64 or depend on stale auto-rate DB rows.
+	if len(syntax) > 0 && syntax[0] >= '0' && syntax[0] <= '9' {
+		if !explicitOrderRate.MatchString(syntax) {
+			return decimal.Zero, fmt.Errorf("invalid explicit decimal rate")
+		}
+		value, err := decimal.NewFromString(syntax)
+		if err != nil || !value.IsPositive() {
+			return decimal.Zero, fmt.Errorf("explicit rate must be positive")
+		}
+		return value, nil
+	}
