+package model
+
+import (
+	"github.com/shopspring/decimal"
+	"testing"
+)
+
+func TestExplicitOrderRateNoDatabaseOrFloat(t *testing.T) {
+	for _, raw := range []string{"6.67", "6.6623951423103795", "0.000000000000000001", "999999999999999999"} {
+		got, err := GetOrderRate(Crypto("USDT"), Fiat("CNY"), raw)
+		if err != nil || !got.Equal(decimal.RequireFromString(raw)) {
+			t.Fatalf("decimal rate %s: %s %v", raw, got, err)
+		}
+	}
+	for _, raw := range []string{"0", "0.0", "1e999999", "1e2", "6.7.8", "9999999999999999999", "0.0000000000000000001"} {
+		if _, err := GetOrderRate(Crypto("USDT"), Fiat("CNY"), raw); err == nil {
+			t.Fatalf("accepted invalid explicit rate %s", raw)
+		}
+	}
+}
