# 确保所有 SQL 迁移文件使用 LF 换行符
backend/migrations/*.sql text eol=lf

# Go 源代码文件
*.go text eol=lf

# 前端 源代码文件
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.vue text eol=lf

# Shell 脚本
*.sh text eol=lf

# YAML/YML 配置文件
*.yaml text eol=lf
*.yml text eol=lf

# Dockerfile
Dockerfile text eol=lf

# 二开版本号：合并上游时始终保留本仓库的 VERSION（sub2api-custom）。
# merge=ours 需要本地注册驱动才生效（只需一次）：
#   git config merge.ours.driver true
# .github/workflows/upstream-sync.yml 与 tools/sync-upstream.ps1 已自动设置。
# 注意：只有两边都改过该文件时才会调用驱动；同步脚本合并后仍会写回 fork 版本号兜底。
backend/cmd/server/VERSION merge=ours
